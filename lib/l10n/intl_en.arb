  "sprainstrains_q9_opt3": "Numbness, tingling, or blue/cold fingers or toes",
  "sprainstrains_q9_opt4": "A clean dressing",
  "sprainstrains_q10": "When should the person return to sport?",
  "sprainstrains_q10_explanation": "Returning too soon can worsen an injury.",
  "sprainstrains_q10_opt1": "Immediately regardless of pain",
  "sprainstrains_q10_opt2": "When swelling first begins",
  "sprainstrains_q10_opt3": "Only after masking pain",
  "sprainstrains_q10_opt4": "When function has recovered and return is appropriate; seek advice for significant injury",
  "stroke_q1_explanation": "Sudden facial droop and arm weakness may indicate stroke; time matters.",
  "stroke_q2_explanation": "FAST is a common stroke recognition aid.",
  "stroke_q3_explanation": "Symptoms that resolve may represent a transient ischemic attack and still need urgent assessment.",
  "stroke_q4_explanation": "Do not give oral intake because swallowing may be impaired.",
  "stroke_q5_explanation": "Time information can influence stroke treatment decisions.",
  "stroke_q6_explanation": "Stroke can cause a range of sudden neurological symptoms.",
  "stroke_q7": "What should you do while waiting for an ambulance for suspected stroke?",
  "stroke_q7_explanation": "Monitor and protect the person while awaiting emergency care.",
  "stroke_q7_opt1": "Make the person exercise",
  "stroke_q7_opt2": "Give alcohol",
  "stroke_q7_opt3": "Keep them safe, monitor responsiveness and breathing, and follow dispatcher instructions",
  "stroke_q7_opt4": "Let them drive",
  "stroke_q8": "A person with suspected stroke becomes unconscious but is breathing normally. What should you do?",
  "stroke_q8_explanation": "Protect the airway and monitor breathing; follow dispatcher instructions.",
  "stroke_q8_opt1": "Give them water",
  "stroke_q8_opt2": "Make them stand",
  "stroke_q8_opt3": "Leave them alone",
  "stroke_q8_opt4": "Call emergency services, monitor breathing, and position safely to protect the airway if appropriate",
  "stroke_q9": "Can a stroke occur in a younger adult?",
  "stroke_q9_explanation": "Stroke is more common with age but can affect younger people too.",
  "stroke_q9_opt1": "Yes; stroke can happen at any age",
  "stroke_q9_opt2": "No, only older people have strokes",
  "stroke_q9_opt3": "Only during sleep",
  "stroke_q9_opt4": "Only after a fall",
  "stroke_q10": "What is the safest response to sudden stroke-like symptoms?",
  "stroke_q10_explanation": "Rapid emergency assessment is important even if symptoms fluctuate.",
  "stroke_q10_opt1": "Wait to see if they improve",
  "stroke_q10_opt2": "Treat it as an emergency even if symptoms are mild or resolve",
  "stroke_q10_opt3": "Drive them yourself if they are confused",
  "stroke_q10_opt4": "Give food first",
  "wound_care_q1_explanation": "Hand hygiene and barrier protection reduce contamination risk.",
  "wound_care_q2_explanation": "Clean water can remove dirt from minor wounds.",
  "wound_care_q3_explanation": "Control severe bleeding before routine wound cleaning.",
  "wound_care_q4_explanation": "Rinse minor debris away; deep or embedded material needs medical care.",
  "wound_care_q5_explanation": "Some wounds need closure, tetanus review, or infection treatment.",
  "wound_care_q6_explanation": "Worsening local symptoms or fever can indicate infection.",
  "wound_care_q7": "What should you do with an object embedded in a wound?",
  "wound_care_q7_explanation": "Removing embedded objects can worsen bleeding.",
  "wound_care_q7_opt1": "Do not remove it; apply pressure around it and seek medical help",
  "wound_care_q7_opt2": "Pull it out regardless of depth",
  "wound_care_q7_opt3": "Push it farther in",
  "wound_care_q7_opt4": "Twist it to loosen it",
  "wound_care_q8": "Why is tetanus vaccination status relevant for some wounds?",
  "wound_care_q8_explanation": "A clinician can advise whether tetanus vaccination or other prevention is needed.",
  "wound_care_q8_opt1": "It determines eye colour",
  "wound_care_q8_opt2": "Some wounds can expose a person to tetanus bacteria, so vaccination may need review",
  "wound_care_q8_opt3": "It stops all bleeding immediately",
  "wound_care_q8_opt4": "It replaces cleaning",
  "wound_care_q9": "How should you cover a cleaned minor wound?",
  "wound_care_q9_explanation": "A clean dressing protects the wound from contamination.",
  "wound_care_q9_opt1": "With dirty tissue",
  "wound_care_q9_opt2": "With soil",
  "wound_care_q9_opt3": "With a clean dressing or plaster appropriate to the wound",
  "wound_care_q9_opt4": "With household glue",
  "wound_care_q10": "What should you do if redness and pain around a wound are spreading?",
  "wound_care_q10_explanation": "Spreading redness or worsening pain may indicate infection.",
  "wound_care_q10_opt1": "Ignore it for weeks",
  "wound_care_q10_opt2": "Rub it aggressively",
  "wound_care_q10_opt3": "Cover it with cosmetics",
  "wound_care_q10_opt4": "Seek medical advice promptly",
  "assess_q1_explanation": "Scene safety comes before casualty assessment.",
  "assess_q2_explanation": "Unresponsiveness requires urgent assessment and help.",
  "assess_q3_explanation": "Check for normal breathing promptly; gasping is not normal breathing.",
  "assess_q4_explanation": "These signs need immediate emergency action.",
  "assess_q5_explanation": "A brief history can guide assessment without delaying urgent care.",
  "assess_q6_explanation": "Comparing sides can reveal injuries, but avoid painful or risky movement.",
  "assess_q7": "What should you do if a person has severe bleeding and is confused?",
  "assess_q7_explanation": "Severe bleeding and altered mental status can be life-threatening.",
  "assess_q7_opt1": "Give them a meal",
  "assess_q7_opt2": "Ask them to walk",
  "assess_q7_opt3": "Call emergency services and control bleeding while monitoring breathing",
  "assess_q7_opt4": "Leave them to rest alone",
  "assess_q8": "What does AVPU stand for in a basic responsiveness assessment?",
  "assess_q8_explanation": "AVPU is a simple scale: Alert, responds to Voice, responds to Pain, Unresponsive. Lay rescuers should follow their training.",
  "assess_q8_opt1": "Airway, Vision, Pulse, Urine",
  "assess_q8_opt2": "Alert, Voice, Pulse, Unconscious",
  "assess_q8_opt3": "Assess, Verify, Protect, Understand",
  "assess_q8_opt4": "Alert, Voice, Pain, Unresponsive",
  "assess_q9": "Should you move a casualty with possible spinal injury just to make the assessment easier?",
  "assess_q9_explanation": "Avoid unnecessary movement when serious trauma is suspected.",
  "assess_q9_opt1": "No; avoid unnecessary movement unless safety or life-saving care requires it",
  "assess_q9_opt2": "Yes, always",
  "assess_q9_opt3": "Only to test their neck",
  "assess_q9_opt4": "Yes, without asking",
  "assess_q10": "What information is useful in a handover to emergency responders?",
  "assess_q10_explanation": "A concise factual handover helps continuing care.",
  "assess_q10_opt1": "Rumours from bystanders only",
  "assess_q10_opt2": "What happened, symptoms observed, changes, and first aid given",
  "assess_q10_opt3": "A guess about the diagnosis only",
  "assess_q10_opt4": "Nothing if the person is awake",
  "recovery_pos_q1_explanation": "The recovery position can help keep the airway clear in an unconscious breathing person when appropriate.",
  "recovery_pos_q2_explanation": "It helps protect the airway in an unconscious person who is breathing normally.",
  "recovery_pos_q3_explanation": "Abnormal breathing with unresponsiveness requires CPR, not simply the recovery position.",
  "recovery_pos_q4_explanation": "Continue monitoring because their condition may change.",
  "recovery_pos_q5_explanation": "Spinal precautions matter, but airway and breathing take priority; follow trained guidance.",
  "recovery_pos_q6_explanation": "Use it when appropriate after the seizure if normal breathing is present and no injury prevents positioning.",
  "recovery_pos_q7": "Should you place an unconscious person in the recovery position if they are gasping abnormally?",
  "recovery_pos_q7_explanation": "Gasping is not normal breathing and may indicate cardiac arrest.",
  "recovery_pos_q7_opt1": "No; gasping is not normal breathing, so activate emergency help and start CPR",
  "recovery_pos_q7_opt2": "Yes, always",
  "recovery_pos_q7_opt3": "Give water first",
  "recovery_pos_q7_opt4": "Wait ten minutes",
  "recovery_pos_q8": "What is important when rolling a breathing unconscious person?",
  "recovery_pos_q8_explanation": "Use a controlled movement and avoid unnecessary twisting, especially if trauma is possible.",
  "recovery_pos_q8_opt1": "Pull them by one arm roughly",
  "recovery_pos_q8_opt2": "Position them carefully, keeping the airway open and avoiding unnecessary movement",
  "recovery_pos_q8_opt3": "Twist their neck repeatedly",
  "recovery_pos_q8_opt4": "Make them stand",
  "recovery_pos_q9": "What should you do if breathing becomes abnormal while the person is in the recovery position?",
  "recovery_pos_q9_explanation": "Reassess immediately and start CPR if they are unresponsive and not breathing normally.",
  "recovery_pos_q9_opt1": "Wait until they wake",
  "recovery_pos_q9_opt2": "Give a snack",
  "recovery_pos_q9_opt3": "Call emergency services and begin CPR as indicated",
  "recovery_pos_q9_opt4": "Leave them alone",
  "recovery_pos_q10": "Should a person in the recovery position be left unattended?",
  "recovery_pos_q10_explanation": "Continuous monitoring is important.",
  "recovery_pos_q10_opt1": "Yes, always",
  "recovery_pos_q10_opt2": "Only if they are breathing loudly",
  "recovery_pos_q10_opt3": "Yes, after one check",
  "recovery_pos_q10_opt4": "No; stay with them and keep monitoring until help takes over",
